PORT=3000
# SQLite file (created on first run)
DB_PATH=./data/callflow.db
# Comma-separated STUN urls
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# coturn REST auth: same value as static-auth-secret in turnserver.conf. Leave empty for STUN only.
TURN_SECRET=
# Comma-separated TURN urls, e.g. turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
